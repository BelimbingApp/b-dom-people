<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="people">
  <.page id="people-employees" variant={:list}>
    <.header>Employees<:subtitle :if={@company}>{@company.name} · People workbench</:subtitle></.header>
    <p :if={is_nil(@company)} class="mt-4 text-sm text-ink-muted">This company is unavailable.</p>
    <div :if={@company} class="mt-5">
      <form id="people-employee-filter" phx-change="filter" class="mb-3 flex flex-wrap items-center gap-2">
        <input name="search" value={@search} aria-label="Search employees" placeholder="Search name or number" class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm" />
        <select name="status" aria-label="Filter status" class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm">
          <option value="">All statuses</option>
          <option :for={status <- ~w(pending probation active inactive terminated)} value={status} selected={@status == status}>{String.capitalize(status)}</option>
        </select>
      </form>
      <p :if={@employees == []} class="rounded-xl border border-line bg-surface p-5 text-sm text-ink-muted">No employees match this view.</p>
      <div :if={@employees != []} class="overflow-x-auto border border-line bg-surface">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-sunken text-xs text-ink-muted"><tr><th class="px-2 py-1.5">Employee</th><th class="px-2 py-1.5">Number</th><th class="px-2 py-1.5">Status</th></tr></thead>
          <tbody><tr :for={employee <- @employees} class="border-t border-line"><td class="px-2 py-0.5"><.link navigate={"/people/employees/#{employee.id}"} class="text-link hover:underline">{employee.full_name}</.link></td><td class="px-2 py-0.5 tabular-nums">{employee.employee_number}</td><td class="px-2 py-0.5">{employee.status}</td></tr></tbody>
        </table>
      </div>
      <section class="mt-5 rounded-xl border border-line bg-surface p-5">
        <h2 class="text-sm font-semibold text-ink">Saved views</h2>
        <p :if={@views == []} class="mt-2 text-sm text-ink-muted">No saved views yet.</p>
        <div :for={view <- @views} class="mt-2 flex items-center gap-3 text-sm">
          <button type="button" phx-click="open_view" phx-value-id={view.id} class="text-link hover:underline">{view.name}</button>
          <button type="button" phx-click="delete_view" phx-value-id={view.id} aria-label={"Delete #{view.name}"} class="text-ink-muted hover:text-danger-ink">Remove</button>
        </div>
        <form phx-submit="save_view" class="mt-3 flex flex-wrap gap-2">
          <input name="view[name]" aria-label="View name" placeholder="View name" required maxlength="120" class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm" />
          <button type="submit" class="rounded-md bg-action px-3 py-1.5 text-sm text-action-ink">Save current view</button>
        </form>
      </section>
    </div>
  </.page>
</Layouts.app>
